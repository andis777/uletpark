{
  "name": "uletnaya-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@uletnaya/api",
    "dev:mobile": "turbo run dev --filter=@uletnaya/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @uletnaya/db generate",
    "db:migrate": "pnpm --filter @uletnaya/db migrate",
    "db:studio": "pnpm --filter @uletnaya/db studio",
    "db:seed:loyalty": "pnpm --filter @uletnaya/db seed:loyalty",
    "db:seed:admin": "pnpm --filter @uletnaya/db seed:admin",
    "db:migrate:analytics": "pnpm --filter @uletnaya/db migrate:analytics",
    "amocrm:backfill": "pnpm --filter @uletnaya/db backfill:amocrm"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  }
}
