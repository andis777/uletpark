# --- Postgres (Neon через Vercel Marketplace) ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- JWT (генерировать: openssl rand -base64 64) ---
JWT_SECRET=change_me_to_long_random_string

# --- SMS.ru (для OTP) ---
SMSRU_API_ID=stub
SMSRU_FROM=Uletnaya
# Если SMSRU_API_ID=stub — OTP пишется в логи и не отправляется

# --- amoCRM ---
AMOCRM_DOMAIN=uletnayaparkovka.amocrm.ru
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=https://api.uletnayaparkovka.ru/api/webhooks/amocrm/oauth
AMOCRM_REFRESH_TOKEN=
# Если все пустые — клиент работает в STUB-режиме (мок-данные)

# --- Webhook validation ---
AMOCRM_WEBHOOK_SECRET=

# --- Admin panel ---
ADMIN_KEY=optional_legacy_x_admin_key_for_curl_loyalty_rules

# --- Sentry (Phase 5) ---
SENTRY_DSN=

# --- Vercel Cron (Phase 4 analytics refresh) ---
CRON_SECRET=

# --- App ---
PUBLIC_API_URL=http://localhost:3000
NODE_ENV=development
