{
  "expo": {
    "name": "Улётная парковка",
    "slug": "uletnaya-parkovka",
    "scheme": "uletnaya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#1F2430",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ru.uletnayaparkovka.app",
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "ru.uletnayaparkovka.app",
      "adaptiveIcon": { "backgroundColor": "#1F2430" }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "apiUrl": "https://api.uletnayaparkovka.ru"
    }
  }
}
