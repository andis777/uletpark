{
  "expo": {
    "name": "Улётная парковка",
    "slug": "uletnaya-parkovka",
    "scheme": "uletnaya",
    "version": "1.2.2",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6efb0108-5626-49b8-8ace-f852d3b292ad"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#1F2430",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ru.uletnayaparkovka.app",
      "buildNumber": "11",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["yandexnavi", "yandexmaps"],
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "api.uletnayaparkovka.ru": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true,
              "NSExceptionMinimumTLSVersion": "TLSv1.2"
            }
          }
        }
      }
    },
    "android": {
      "package": "ru.uletnayaparkovka.app",
      "versionCode": 11,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F2430"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withYandexQueries.js",
      "./plugins/withFmtConstevalFix.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://api.uletnayaparkovka.ru",
      "//yandexClientId": "ID приложения из oauth.yandex.ru. Публичный (client_secret живёт только на сервере). Пусто — кнопка «Войти через Яндекс» скрыта.",
      "yandexClientId": "",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6efb0108-5626-49b8-8ace-f852d3b292ad"
      }
    },
    "owner": "djbuba"
  }
}
