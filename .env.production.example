# =========================================================================
# Production .env — копируется на сервер в /opt/uletnaya/.env.production
# Никогда не коммитим в git!
# =========================================================================

# --- Postgres (внутри docker compose) ---
POSTGRES_DB=uletnaya
POSTGRES_USER=uletnaya
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# DATABASE_URL формируется в docker-compose.yml автоматически
# (api подключается к контейнеру postgres внутри docker сети)

# --- JWT ---
# Сгенерить: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_64_CHARS_RANDOM

# --- SMS.ru (для боевого OTP) ---
SMSRU_API_ID=ваш_api_id_от_sms.ru
SMSRU_FROM=Uletnaya

# --- amoCRM (после получения OAuth ключей) ---
AMOCRM_DOMAIN=vsteh.amocrm.ru
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REFRESH_TOKEN=
AMOCRM_REDIRECT_URI=https://api.uletnayaparkovka.ru/api/webhooks/amocrm/oauth

# --- Cron secret для self-hosted cron ---
# Сгенерить: openssl rand -hex 32
CRON_SECRET=CHANGE_ME_32_HEX

# --- Sentry (опционально, для error tracking) ---
SENTRY_DSN=

# --- Image identification (для docker compose) ---
REGISTRY=ghcr.io
IMAGE_NAME=ВЛАДЕЛЕЦ/uletnaya-api
IMAGE_TAG=latest

# --- App ---
NODE_ENV=production
PUBLIC_API_URL=https://api.uletnayaparkovka.ru
